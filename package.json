{
  "name": "ia-tmu-ge2026",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run fetch-works && next build && npm run postbuild",
    "fetch-works": "npx tsx build-scripts/fetch-works-cache.ts",
    "build:no-export": "SKIP_EXPORT=true next build",
    "postbuild": "node build-scripts/generate-index.js",
    "start": "next start",
    "lint": "eslint",
    "serve:export": "npm run prepare:export && npx serve@latest out -p 3001",
    "prepare:export": "cd out && ln -sf . ge2026 2>/dev/null || true"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "framer-motion": "^11.11.17",
    "google-auth-library": "^10.5.0",
    "googleapis": "^170.0.0",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "i18next-resources-to-backend": "^1.2.1",
    "next": "16.0.10",
    "next-i18n-router": "^5.5.5",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.3.3",
    "react-router-dom": "^7.9.5",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "volta": {
    "node": "22.21.1"
  }
}
